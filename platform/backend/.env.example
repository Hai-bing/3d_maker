# ComfyUI/SDXL 2D 图片生成
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFYUI_TIMEOUT=600
COMFYUI_WIDTH=1024
COMFYUI_HEIGHT=1024
# Hunyuan3D 2.0 图片转3D
# HUNYUAN3D_PYTHON: Python 解释器路径（默认用 PATH 中的 python）
HUNYUAN3D_PYTHON=python
# HUNYUAN3D_MODEL: 模型 ID 或本地路径（mini 版适合 8GB 显存）
HUNYUAN3D_MODEL=tencent/Hunyuan3D-2mini
# 推理步数（越大越精细，速度越慢）
HUNYUAN3D_STEPS=30
# 是否生成纹理贴图
HUNYUAN3D_TEX=true
# Octree 分辨率（越大越精细，显存占用越高）
HUNYUAN3D_OCTREE_RES=256
# 生成超时秒数
HUNYUAN3D_TIMEOUT=600
HOST=0.0.0.0
PORT=5000
# FRONTEND_ORIGIN=http://localhost:5000
